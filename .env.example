# =============================================================================
# ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ. Реальные значения — только в .env.local / панели
# хостинга. Никаких настоящих ключей в git.
# =============================================================================

# ── База данных (Timeweb Cloud PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Схема приложения (AI Sales таблицы живут в es_app):
DATABASE_SEARCH_PATH=es_app,public
# TLS (обычно достаточно бандла certs/timeweb-cloud-ca.pem):
# DATABASE_SSL_SERVERNAME=xxxxx.twc1.net
# DATABASE_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ── Сессии/авторизация ─────────────────────────────────────────────────
AUTH_SESSION_SECRET=change-me-long-random
EDITOR_SESSION_SECRET=change-me-long-random
EDITOR_EMAIL=proeco09@yandex.ru

# ── Bitrix24 (входящий REST-вебхук, scope: crm + disk) ─────────────────
# https://<portal>.bitrix24.ru/rest/<user_id>/<code>/
BITRIX24_WEBHOOK_URL=
# Токен исходящего вебхука Bitrix (application_token) — проверяется приёмником
# /api/integrations/bitrix/webhook. Настраивается в «Разработчикам → Исходящий вебхук».
BITRIX24_EVENT_TOKEN=

# ── Cron (Vercel Cron / внешний планировщик) ───────────────────────────
# Дренаж очереди AI-задач вызывается с Authorization: Bearer $CRON_SECRET
CRON_SECRET=change-me-long-random

# ── AI Sales: LLM-провайдер анализа ────────────────────────────────────
# AI_PROVIDER = anthropic (Claude) | yandex (YandexGPT).
AI_PROVIDER=yandex

# Claude (если AI_PROVIDER=anthropic):
ANTHROPIC_API_KEY=
AI_MODEL_ANALYSIS=claude-opus-5
AI_MODEL_CLASSIFY=claude-haiku-4-5

# YandexGPT (если AI_PROVIDER=yandex) — переиспользует ключи SpeechKit ниже,
# отдельные не обязательны. Для длинных транскриптов: yandexgpt-32k/latest.
YANDEX_GPT_MODEL=yandexgpt/latest
# YANDEX_GPT_API_KEY=      # по умолчанию = YANDEX_STT_API_KEY
# YANDEX_GPT_FOLDER_ID=    # по умолчанию = YANDEX_FOLDER_ID

# ── AI Sales: транскрипция ─────────────────────────────────────────────
# yandex — Yandex SpeechKit longRunning (как в рабочем пайплайне «Единой среды»);
# whisper — Whisper-совместимый STT (zero-infra альтернатива для теста).
TRANSCRIPTION_PROVIDER=yandex

# Yandex SpeechKit (STT) — требует аудио в Object Storage (см. ниже).
YANDEX_STT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_STT_LANG=ru-RU

# Yandex Object Storage (S3-совместимо) — куда кладём аудио для SpeechKit longRunning.
YANDEX_S3_ENDPOINT=storage.yandexcloud.net
YANDEX_S3_REGION=ru-central1
YANDEX_S3_BUCKET=
YANDEX_S3_ACCESS_KEY=
YANDEX_S3_SECRET_KEY=

# Whisper-совместимый провайдер (если TRANSCRIPTION_PROVIDER=whisper).
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# =============================================================================
# Существующие интеграции проекта (почта, VK, Яндекс, Метрика) — см. README.
# Ниже перечислены ключи, которые уже использует проект:
# =============================================================================
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS= SMTP_FROM= SMTP_SECURE=
# IMAP_HOST= IMAP_PORT= IMAP_USER= IMAP_PASS= IMAP_SECURE= IMAP_MAILBOX=
# MAIL_SECRET_KEY=
# NEXT_PUBLIC_SUPABASE_URL= NEXT_PUBLIC_SUPABASE_ANON_KEY= SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_VK_CLIENT_ID= VK_CLIENT_SECRET= VK_SERVICE_TOKEN= VK_STATS_TOKEN=
# NEXT_PUBLIC_YANDEX_CLIENT_ID= YANDEX_CLIENT_SECRET=
# YANDEX_METRIKA_COUNTER= YANDEX_METRIKA_TOKEN=
